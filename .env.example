# MySQL Database Configuration
MYSQL_DATABASE=placement_db
MYSQL_USER=placement_user
MYSQL_PASSWORD=placement_pass
MYSQL_ROOT_PASSWORD=root_pass

# Spring Application Environment Overrides
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/placement_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=placement_user
SPRING_DATASOURCE_PASSWORD=placement_pass

# JWT & Security Secrets (minimum 256 bits for HMAC-SHA256)
JWT_SECRET=placement-campus-recruitment-portal-jwt-secret-key-32bytes-min

